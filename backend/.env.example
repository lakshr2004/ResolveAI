
# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Database Configuration (Local Development)
DATABASE_URL=sqlite:///./resolveai.db

# Qdrant Configuration
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=resolveai_knowledge

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG Configuration
CHUNK_SIZE=700
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.35
TOP_K=5

# Document Upload Configuration
MAX_UPLOAD_MB=10
# Request Body Configuration
MAX_REQUEST_BODY_MB=12

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Initial Admin Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
ADMIN_FULL_NAME=ResolveAI Admin
